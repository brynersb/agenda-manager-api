{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/node_modules",
      "!**/.docs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useImportType": "error"
      },
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/infrastructure/**",
        "**/*.module.ts",
        "src/main.ts",
        "src/app.setup.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    },
    {
      "includes": ["**/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "typeorm": "A camada domain é TypeScript puro (ADR-002).",
                  "class-validator": "A camada domain é TypeScript puro (ADR-002).",
                  "class-transformer": "A camada domain é TypeScript puro (ADR-002)."
                },
                "patterns": [
                  {
                    "group": ["@nestjs/*"],
                    "message": "A camada domain é TypeScript puro (ADR-002)."
                  },
                  {
                    "group": ["**/application/**", "**/infrastructure/**"],
                    "message": "domain não depende de application nem de infrastructure (ADR-002)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/application/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "typeorm": "A camada application não conhece o ORM (ADR-002)."
                },
                "patterns": [
                  {
                    "group": ["**/infrastructure/**"],
                    "message": "application não depende de infrastructure (ADR-002)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              [":ALIAS:", ":PATH:"]
            ]
          }
        }
      }
    }
  }
}
