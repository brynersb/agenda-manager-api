{
  "name": "pauta-mkt-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "validate": "biome ci . && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run -c vitest.config.e2e.mts",
    "migration:create": "typeorm migration:create",
    "migration:generate": "npm run build && typeorm migration:generate -d dist/database/typeorm.config.js",
    "migration:run": "typeorm migration:run -d src/database/typeorm.config.ts",
    "migration:revert": "typeorm migration:revert -d src/database/typeorm.config.ts",
    "migration:show": "typeorm migration:show -d src/database/typeorm.config.ts",
    "migration:run:prod": "typeorm migration:run -d dist/database/typeorm.config.js",
    "seed:dev": "npm run build && node dist/database/seeds/run-seed.js",
    "load:seed": "node scripts/seed-load.ts",
    "load:clean": "node scripts/seed-load.ts --clean",
    "load:measure": "node scripts/measure-load.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "11.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "4.1.0",
    "nest-winston": "1.10.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "uuid": "14.0.3",
    "winston": "3.19.0"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.10",
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "tsc-alias": "1.9.10",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
