# Copie para `.env` e ajuste. Só placeholders: nunca grave segredo real aqui.

# development | test | production
NODE_ENV=development
# local | e2e | demo  (demo = stack completa da demonstração; exige CORS_ORIGINS e JWT_SECRET)
STAGE=local
PORT=3000
# Fuso IANA usado para calcular "hoje" (prazo das pautas)
APP_TIMEZONE=America/Sao_Paulo
# Origens permitidas no CORS, separadas por vírgula. Obrigatório fora de local/e2e.
CORS_ORIGINS=http://localhost:5173
# error | warn | info | debug
LOG_LEVEL=info
# Limite de requisições por minuto, por IP
THROTTLE_LIMIT_PER_MINUTE=300
# Swagger em /docs (true | false)
SWAGGER_ENABLED=true

# Conexão com o Postgres, em variáveis separadas. Os padrões abaixo só valem em STAGE=local
# (Postgres do docker/compose.yaml, porta 5433); fora dele as cinco e DATABASE_SSL são obrigatórias.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=pauta
DATABASE_PASS=pauta
DATABASE_NAME=pauta
# TLS na conexão: true para Neon/produção, false no Postgres local (true | false)
DATABASE_SSL=false
# Com DATABASE_SSL=true: validar o certificado do servidor (true | false)
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Máximo de conexões do pool
DATABASE_POOL_MAX=10

# --- Autenticação própria (ADR-016; ver docs/auth.md) ---
# Segredo HMAC dos access tokens (HS256): mínimo de 32 caracteres. Em STAGE=local/e2e vale um
# padrão de desenvolvimento embutido; fora deles é OBRIGATÓRIO e o padrão é recusado.
# Gere com: openssl rand -base64 48   (nunca versione o valor real)
# JWT_SECRET=
# `iss` e `aud` fixos do access token
JWT_ISSUER=pauta-mkt-api
JWT_AUDIENCE=pauta-mkt
# Validade do access token e do refresh token (inteiro + s|m|h|d)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Falhas de senha seguidas que bloqueiam a conta, e por quantos minutos
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Limite de requisições por minuto, por IP, em POST /auth/login e /auth/change-password
LOGIN_THROTTLE_LIMIT_PER_MINUTE=10

# Administrador inicial: criado ao subir SOMENTE se não existir nenhum usuário e as duas variáveis
# estiverem definidas (as duas ou nenhuma). Nasce com troca de senha obrigatória. A senha tem 10 a
# 128 caracteres. Em desenvolvimento prefira `npm run seed:dev`.
# BOOTSTRAP_ADMIN_EMAIL=admin@pauta.local
# BOOTSTRAP_ADMIN_PASSWORD=

# `npm run seed:dev` (só STAGE=local ou demo) cria dev.admin@pauta.local, dev.editor@pauta.local e
# dev.leitor@pauta.local com a SENHA SÓ DE DESENVOLVIMENTO "dev-only-pauta-2026" (pública, nunca use
# fora de uma máquina de desenvolvimento). Para trocá-la:
# SEED_DEV_PASSWORD=
