# Copie para `.env` e ajuste. Só placeholders: nunca grave segredo real aqui.

# development | test | production
NODE_ENV=development
# local | e2e | demo  (demo = stack completa da demonstração; exige CORS_ORIGINS)
STAGE=local
PORT=3000
# Fuso IANA usado para calcular "hoje" (prazo das pautas)
APP_TIMEZONE=America/Sao_Paulo
# Origens permitidas no CORS, separadas por vírgula. Obrigatório fora de local/e2e.
CORS_ORIGINS=http://localhost:5173
# error | warn | info | debug
LOG_LEVEL=info
# Limite de requisições por minuto, por IP
THROTTLE_LIMIT_PER_MINUTE=300
# Swagger em /docs (true | false)
SWAGGER_ENABLED=true

# Conexão com o Postgres, em variáveis separadas. Os padrões abaixo só valem em STAGE=local
# (Postgres do docker/compose.yaml, porta 5433); fora dele as cinco e DATABASE_SSL são obrigatórias.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=pauta
DATABASE_PASS=pauta
DATABASE_NAME=pauta
# TLS na conexão: true para Neon/produção, false no Postgres local (true | false)
DATABASE_SSL=false
# Com DATABASE_SSL=true: validar o certificado do servidor (true | false)
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Máximo de conexões do pool
DATABASE_POOL_MAX=10

# --- Autenticação (Keycloak) ---
# Issuer do realm. Obrigatório, exceto com STAGE=e2e ou STAGE=local com AUTH_MOCK_ENABLED=true.
OIDC_ISSUER_URL=http://localhost:8080/realms/bora
# Audiences aceitas, separadas por vírgula (o `aud` do token precisa conter alguma). Mesma regra de obrigatoriedade.
OIDC_AUDIENCE=pauta-mkt-api
# Opcional: padrão ${OIDC_ISSUER_URL}/protocol/openid-connect/certs
# OIDC_JWKS_URI=
# Claim com os papéis do usuário (caminho com ponto)
OIDC_ROLES_CLAIM=realm_access.roles
# Usuário mock sem Keycloak. Só vale com STAGE=local; true com outro STAGE impede a API de subir.
AUTH_MOCK_ENABLED=false
# Papel do usuário mock: content-brief-editor | content-brief-viewer
AUTH_MOCK_ROLE=content-brief-editor
